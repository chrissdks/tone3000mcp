# Server-side credential from https://www.tone3000.com/settings
# Never expose this value in client code or logs.
TONE3000_SECRET_KEY=t3k_cs_replace_me

# Optional overrides
TONE3000_API_BASE_URL=https://www.tone3000.com/api/v1
TONE3000_CACHE_TTL_SECONDS=300
TONE3000_TIMEOUT_MS=12000
PORT=8787
HOST=127.0.0.1

# Local profile store. Defaults to .cache/user-profiles.json.
PROFILE_STORE_PATH=.cache/user-profiles.json

# Pinned external compiler used to create native .t3kpreset files.
# Initialize it with: git submodule update --init --recursive
TONE3000_PRESET_BUILDER_PATH=vendor/tone3000-preset-builder
PRESET_OUTPUT_PATH=.cache/generated-presets
PRESET_BUILDER_TIMEOUT_MS=120000
PYTHON_COMMAND=python
